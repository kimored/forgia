      "id": "riattivazione",
      "name": "Fase 1 · Riattivazione",
      "fromWeek": 1,
      "toWeek": 4,
      "duration": "45–55 min",
      "rotation": ["fb"],
      "weeks": [
        { "weeks": [1], "sets": 2, "rir": "4–5", "rest": [60, 90] },
        { "weeks": [2], "sets": 2, "rir": "3–4", "rest": [60, 90] },
        { "weeks": [3], "sets": 3, "rir": "3", "rest": [90, 90] },
        { "weeks": [4], "sets": 3, "rir": "2", "rest": [90, 90] }
      ],
      "templates": [
        {
          "id": "fb",
          "name": "Full body",
          "exercises": [
            { "exercise": "leg-press", "reps": "12-15" },
            { "exercise": "chest-press", "reps": "12-15", "alternatives": ["panca-manubri"] },
            {
              "exercise": "trazioni",
              "reps": "4",
              "sets": 4,
              "rest": [120, 120],
              "byWeek": [{ "weeks": [3, 4], "reps": "5" }],
